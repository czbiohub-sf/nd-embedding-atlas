{
  "data": {},
  "layouts": {
    "exploration": {
      "name": "Exploration",
      "spec": {
        "root": "root",
        "elements": {
          "root": {
            "type": "split",
            "props": { "direction": "column", "ratio": 0.68 },
            "children": ["top", "bottom"]
          },
          "top": {
            "type": "split",
            "props": { "direction": "row", "ratio": 0.74 },
            "children": ["embedding", "right"]
          },
          "embedding": {
            "type": "scatter",
            "props": {
              "title": "Embedding",
              "filter": { "$bindState": "/filter/A" },
              "focus": { "$bindState": "/focus/A" }
            },
            "children": []
          },
          "right": {
            "type": "split",
            "props": { "direction": "column", "ratio": 0.48 },
            "children": ["image", "gallery"]
          },
          "image": {
            "type": "image-viewer",
            "props": { "title": "Image viewer", "focus": { "$bindState": "/focus/A" } },
            "children": []
          },
          "gallery": {
            "type": "gallery",
            "props": {
              "title": "Crop gallery",
              "filter": { "$bindState": "/filter/A" },
              "focus": { "$bindState": "/focus/A" }
            },
            "children": []
          },
          "bottom": {
            "type": "tabs",
            "props": { "active": "table" },
            "children": ["table", "histogram"]
          },
          "table": {
            "type": "table",
            "props": {
              "title": "Table",
              "filter": { "$bindState": "/filter/A" },
              "focus": { "$bindState": "/focus/A" }
            },
            "children": []
          },
          "histogram": {
            "type": "histogram",
            "props": { "title": "Histogram", "filter": { "$bindState": "/filter/A" } },
            "children": []
          }
        }
      }
    },
    "review": {
      "name": "Review",
      "spec": {
        "root": "review-root",
        "elements": {
          "review-root": {
            "type": "split",
            "props": { "direction": "row", "ratio": 0.62 },
            "children": ["review-image", "review-side"]
          },
          "review-image": {
            "type": "image-viewer",
            "props": { "title": "Image viewer", "focus": { "$bindState": "/focus/A" } },
            "children": []
          },
          "review-side": {
            "type": "split",
            "props": { "direction": "column", "ratio": 0.5 },
            "children": ["review-gallery", "review-table"]
          },
          "review-gallery": {
            "type": "gallery",
            "props": {
              "title": "Crop gallery",
              "filter": { "$bindState": "/filter/A" },
              "focus": { "$bindState": "/focus/A" }
            },
            "children": []
          },
          "review-table": {
            "type": "table",
            "props": {
              "title": "Table",
              "filter": { "$bindState": "/filter/A" },
              "focus": { "$bindState": "/focus/A" }
            },
            "children": []
          }
        }
      }
    }
  },
  "layout": "exploration",
  "state": { "filter": { "A": {} }, "focus": { "A": null } }
}
