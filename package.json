{
  "name": "nd-embedding-atlas-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run --filter @ndea/app build",
    "backend": "bun run apps/ndea/src/cli/index.ts view",
    "docs:build": "bun run --cwd docs build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:serve": "bun run --cwd docs start",
    "dev": "bun run apps/ndea/scripts/dev.ts",
    "sync-version": "bun run apps/ndea/scripts/sync-version.ts",
    "gen": "bunx bunli generate",
    "dead-code": "fallow dead-code",
    "audit": "fallow"
  },
  "devDependencies": {
    "@bunli/core": "^0.9.1",
    "@types/bun": "catalog:",
    "bunli": "^0.9.1",
    "eslint-plugin-typegpu": "^0.11.1",
    "fallow": "^3.6.0",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@uwdata/flechette": "^2.5.0",
    "@uwdata/mosaic-core": "^0.29.2",
    "@webgpu/types": "^0.1.71",
    "@zarrita/storage": "^0.2.0",
    "react": "^19.2.7",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.7",
    "zarrita": "^0.7.3",
    "zod": "^4.4.3"
  }
}
