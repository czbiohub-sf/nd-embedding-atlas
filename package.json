{
    "name": "nd-embedding-atlas",
    "version": "0.1.0",
    "description": "Interactive browser-based dashboard linking AI embeddings to source 5D (TCZYX) image data.",
    "license": "MIT",
    "author": "Sricharan Varra <sricharan.varra@czbiohub.org>",
    "bin": {
        "ndea": "./src/cli/index.ts"
    },
    "type": "module",
    "scripts": {
        "dev": "bun run scripts/dev.ts",
        "dev:backend": "bun run src/cli/index.ts",
        "dev:frontend": "cd frontend && vp dev",
        "build": "bun run scripts/build.ts",
        "build:frontend": "cd frontend && vp build",
        "build:binary": "bun build ./src/cli/index.ts --compile --outfile dist/ndea",
        "build:all-platforms": "bun run scripts/build-all.ts",
        "check": "vp check && (cd frontend && vp check)",
        "test": "vp test"
    },
    "dependencies": {
        "@base-ui/react": "^1.3.0",
        "@fontsource-variable/geist-mono": "^5.2.7",
        "@idetik/core": "^0.16.2",
        "@jsquash/webp": "^1.5.0",
        "@tanstack/react-hotkeys": "^0.9.1",
        "@tanstack/react-pacer": "^0.21.1",
        "@tanstack/react-query": "^5.96.1",
        "@tanstack/react-query-devtools": "^5.96.1",
        "@tanstack/react-store": "^0.9.3",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.23",
        "@tanstack/store": "^0.9.3",
        "@typegpu/sdf": "^0.10.0",
        "@uwdata/flechette": "^2.4.0",
        "@uwdata/mosaic-core": "^0.24.2",
        "@uwdata/mosaic-duckdb": "^0.24.2",
        "@uwdata/mosaic-inputs": "^0.24.2",
        "@uwdata/mosaic-sql": "^0.24.2",
        "@zarrita/storage": "^0.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "culori": "^4.0.2",
        "d3-scale-chromatic": "^3.1.0",
        "dockview-react": "^5.2.0",
        "gl-matrix": "^3.4.4",
        "lucide-react": "^1.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-resizable-panels": "^4.9.0",
        "roaring-wasm": "^1.1.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "typedfastbitset": "^0.8.0",
        "typegpu": "^0.10.2",
        "wasm-feature-detect": "^1.8.0",
        "yaml": "^2.8.3",
        "zarrita": "^0.7.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@tailwindcss/vite": "^4.2.2",
        "@types/bun": "^1.3.12",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@webgpu/types": "^0.1.69",
        "agent-browser": "^0.23.4",
        "playwright": "^1.59.1",
        "shadcn": "^4.3.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "unplugin-typegpu": "^0.10.2",
        "vite-plus": "^0.1.18"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@latest",
        "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "packageManager": "bun@1.3.12"
}
