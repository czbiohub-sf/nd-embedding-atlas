{
  "name": "nd-embedding-atlas-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "fallow",
    "dev": "bun x --bun portless run bun apps/ndea/scripts/dev.ts",
    "docs": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:serve": "bun run --cwd docs start",
    "ndea": "bun run apps/ndea/src/cli/index.ts",
    "release:version": "bun run apps/ndea/scripts/release-version.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint-plugin-typegpu": "^0.12.1",
    "fallow": "^3.33.1",
    "portless": "^0.15.8",
    "react-refresh": "^0.19.0",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@base-ui/react": "^1.9.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uwdata/flechette": "^2.7.0",
    "@uwdata/mosaic-core": "^0.33.0",
    "@uwdata/mosaic-sql": "^0.33.0",
    "@webgpu/types": "^0.1.74",
    "@zarrita/storage": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typegpu": "^0.12.8",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "zarrita": "^0.7.5",
    "zod": "^4.6.7"
  },
  "portless": "ndea"
}
