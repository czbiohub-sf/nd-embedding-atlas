{
  "name": "nd-embedding-atlas-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "fallow",
    "audit:gate": "fallow audit",
    "bench:ingest": "vp run build:zarr-ext && bun run apps/ndea/scripts/bench-ingest.ts",
    "bytecode-order": "bun run apps/ndea/scripts/record-bytecode-order.ts",
    "dev": "vp run build:zarr-ext && bun x --bun portless run bun apps/ndea/scripts/dev.ts",
    "docs": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:serve": "bun run --cwd docs start",
    "mutation": "fallow mutation --allow-dirty",
    "ndea": "vp run build:zarr-ext && bun run apps/ndea/src/cli/index.ts",
    "release:version": "bun run apps/ndea/scripts/release-version.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint-plugin-typegpu": "^0.12.1",
    "fallow": "^3.36.0",
    "portless": "^0.15.11",
    "react-refresh": "^0.19.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@base-ui/react": "^1.9.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uwdata/mosaic-core": "^0.34.1",
    "@uwdata/mosaic-sql": "^0.34.1",
    "@webgpu/types": "^0.1.74",
    "@zarrita/storage": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typegpu": "0.12.9",
    "typescript": "^7.0.2",
    "unplugin-typegpu": "0.12.7",
    "vite-plus": "1.4.0",
    "zarrita": "^0.7.5",
    "zod": "^4.6.7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "portless": "ndea"
}
